# Production configuration. On the server: cp deploy/env.production.example .env
# and fill in every value marked with <...>. Never commit the real .env.

# Public domain of the site (e.g. esports-epcc.chilecentral.cloudapp.azure.com).
DOMAIN=<your.domain>
# Optional: other domains that redirect to DOMAIN, comma separated (e.g.
# the old esports-epcc.chilecentral.cloudapp.azure.com).
# REDIRECT_DOMAINS=

# Random, 50+ characters. Generate it on the server with:
#   docker run --rm python:3.13-slim python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<random-secret>
DEBUG=False
# localhost: health check of the container.
ALLOWED_HOSTS=<your.domain>,localhost
CSRF_TRUSTED_ORIGINS=https://<your.domain>
CORS_ALLOWED_ORIGINS=

# Database (container "db"). Use a long random password.
POSTGRES_DB=esports
POSTGRES_USER=esports
POSTGRES_PASSWORD=<random-password>

# Created on the first deploy. Strong password (12+ characters, not only
# numbers): a weak one is not created.
DEFAULT_SUPERADMIN_USERNAME=admin
DEFAULT_SUPERADMIN_PASSWORD=<strong-password>

# API processes: 2 with 1 GB of RAM, 4 with 4 GB or more.
WEB_CONCURRENCY=2

TIME_ZONE=America/Lima
CURRENCY=PEN
MAX_UPLOAD_SIZE_MB=5
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# Request limits per IP.
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=20/hour
THROTTLE_LOOKUP=60/min

API_DOCS=False
# One day while testing; raise it to 31536000 (one year) once HTTPS works.
SECURE_HSTS_SECONDS=86400

# Discord bot (container "bot"). Without these three it stays idle and the
# site's notices to it are rejected. See WEBHOOKS.md.
# Token of the bot: Discord Developer Portal > your app > Bot > Reset Token.
DISCORD_TOKEN=
# Server ID: Discord > right click on the server > Copy Server ID
# (needs Developer Mode on).
DISCORD_GUILD_ID=
# The "Clave" of the bot's address in Admin > Configuración > Avisos
# automáticos (address http://bot:8080/events).
BOT_WEBHOOK_SECRET=
