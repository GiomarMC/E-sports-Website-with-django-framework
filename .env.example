# Production: DEBUG=False and a random SECRET_KEY of 50+ characters (see
# the Deployment section of the README).
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CSRF_TRUSTED_ORIGINS=https://your.domain

# Database. Use POSTGRES_URL, or the POSTGRES_* variables (also read by
# docker-compose). Without any of them a local SQLite database is used.
POSTGRES_DB=esports
POSTGRES_USER=esports
POSTGRES_PASSWORD=esports
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_URL=postgres://user:password@localhost:5432/esports

# Created on the first `migrate` (never overwritten afterwards).
DEFAULT_SUPERADMIN_USERNAME=admin
DEFAULT_SUPERADMIN_PASSWORD=change-me-please

# Optional
TIME_ZONE=America/Lima
CURRENCY=PEN
MAX_UPLOAD_SIZE_MB=5
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# Production / security (optional)
# NUM_PROXIES=1                # behind nginx: real client IP for the limits
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=20/hour
# THROTTLE_LOOKUP=60/min
# PRIVATE_MEDIA_ROOT=/srv/esports/private_media   # vouchers, never public
# CACHE_DIR=/srv/esports/.cache
# API_DOCS=False
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=86400
