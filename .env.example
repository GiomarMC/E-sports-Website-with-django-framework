SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database. Use POSTGRES_URL, or the POSTGRES_* variables (also read by
# docker-compose). Without any of them a local SQLite database is used.
POSTGRES_DB=esports
POSTGRES_USER=esports
POSTGRES_PASSWORD=esports
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_URL=postgres://user:password@localhost:5432/esports

# Created on the first `migrate` (never overwritten afterwards).
DEFAULT_SUPERADMIN_USERNAME=admin
DEFAULT_SUPERADMIN_PASSWORD=change-me-please

# Optional
TIME_ZONE=America/Lima
CURRENCY=PEN
MAX_UPLOAD_SIZE_MB=5
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
